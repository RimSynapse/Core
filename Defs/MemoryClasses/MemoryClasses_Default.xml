    <baseWeight>1.0</baseWeight>
    <decayRate>0</decayRate>
    <bornLongTerm>true</bornLongTerm>
    <consolidationContribution>1.0</consolidationContribution>
  </RimSynapse.SynapseMemoryClassDef>

  <RimSynapse.SynapseMemoryClassDef>
